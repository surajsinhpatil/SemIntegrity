# Copy to .env and fill in locally. .env is gitignored and MUST NEVER be committed.
# Secrets are read from the environment; they are never written to scripts,
# configs, logs, notebooks or command history.

# Hugging Face read token — required for the gated models
# (meta-llama/*, google/gemma-2-9b-it, mistralai/Mistral-7B-Instruct-v0.3).
# Create at https://huggingface.co/settings/tokens AFTER accepting each licence.
HF_TOKEN=

# Repository root on whichever machine is running (laptop or cluster).
SEMINT_ROOT=

# Caches kept inside the working directory, never in a shared location.
HF_HOME=${SEMINT_ROOT}/hf_cache

# D3 judge credentials — only if an API judge is chosen (Q3 is UNRESOLVED).
# JUDGE_API_KEY=
